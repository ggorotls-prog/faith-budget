<?xml version="1.0" encoding="utf-8"?>
<!-- 버튼 둘 + 「안 적은 것 N」 빨간 표(은행·카드 알림에서 온 건이 남아 있을 때만, 2026-11-16) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/fin_widget_bg"
    android:padding="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/fin_in"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/fin_btn_in"
        android:gravity="center"
        android:text="+ 수입"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fin_out"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:background="@drawable/fin_btn_out"
        android:gravity="center"
        android:text="− 지출"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
    <TextView
        android:id="@+id/fin_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/fin_badge_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
